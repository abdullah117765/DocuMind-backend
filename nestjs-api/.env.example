# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173
FASTAPI_URL=http://localhost:8000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_doc_intel?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long
JWT_EXPIRES_IN=15m

# NestJS-to-FastAPI request signing
HMAC_SECRET=replace-with-a-shared-random-secret-at-least-64-characters-long
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# Verification email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=noreply@example.com

# API documentation
SWAGGER_TITLE=AI Document Intelligence API
SWAGGER_VERSION=1.0
