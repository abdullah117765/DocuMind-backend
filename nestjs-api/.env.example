# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173
FASTAPI_URL=http://localhost:8000
RAG_ENABLED=true
RAG_SERVICE_URL=http://localhost:8000
RAG_HMAC_SECRET=replace-with-a-shared-random-secret-at-least-64-characters-long
RAG_REQUEST_TIMEOUT_MS=240000
RAG_INDEXING_TIMEOUT_MS=1800000
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RECOVERY_BATCH_SIZE=3
RAG_FAILED_RETRY_AFTER_MS=120000
RAG_STALE_INDEXING_AFTER_MS=2100000
QDRANT_URL=http://localhost:6333

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_doc_intel?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO document storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_DOCUMENT_BUCKET=documents
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_MAX_FILES_PER_BATCH=8
DOCUMENT_STAGING_TTL_SECONDS=86400
DOCUMENT_UPLOAD_JOB_TTL_SECONDS=86400
DOCUMENT_UPLOAD_JOB_STALE_REQUEUE_SECONDS=2400
DOCUMENT_ZIP_MAX_EXPANDED_BYTES=41943040

# Maintenance cleanup
MAINTENANCE_CLEANUP_ENABLED=true
MAINTENANCE_CLEANUP_INTERVAL_MS=120000
MAINTENANCE_CLEANUP_INITIAL_DELAY_MS=60000
MAINTENANCE_CLEANUP_BATCH_SIZE=25

# Dynamic authorization cache
PERMISSION_CACHE_TTL_SECONDS=300

# Access and refresh tokens
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long
JWT_EXPIRES_IN=15m
JWT_ISSUER=ai-doc-intel-api
JWT_AUDIENCE=ai-doc-intel-web
REFRESH_TOKEN_PEPPER=replace-with-a-different-random-secret-at-least-64-characters-long
REFRESH_TOKEN_TTL_SECONDS=2592000

# Authentication rate limits
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# API rate limits
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_GENERAL_MAX_REQUESTS=240
API_RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
API_RATE_LIMIT_STATE_CHANGING_MAX_REQUESTS=120
API_RATE_LIMIT_STATE_CHANGING_WINDOW_SECONDS=60
API_RATE_LIMIT_DOCUMENT_UPLOAD_MAX_REQUESTS=20
API_RATE_LIMIT_DOCUMENT_UPLOAD_WINDOW_SECONDS=60
API_RATE_LIMIT_RAG_SEARCH_MAX_REQUESTS=30
API_RATE_LIMIT_RAG_SEARCH_WINDOW_SECONDS=60
API_RATE_LIMIT_RAG_ASK_MAX_REQUESTS=10
API_RATE_LIMIT_RAG_ASK_WINDOW_SECONDS=60
API_RATE_LIMIT_RAG_REINDEX_MAX_REQUESTS=5
API_RATE_LIMIT_RAG_REINDEX_WINDOW_SECONDS=60

# Password reset OTP
PASSWORD_RESET_OTP_SECRET=replace-with-another-random-secret-at-least-64-characters-long
PASSWORD_RESET_OTP_TTL_SECONDS=120
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_AUTHORIZATION_TTL_SECONDS=120
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=40
PASSWORD_RESET_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# Email verification
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=900

# Authentication cookies / CSRF
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
PASSWORD_RESET_COOKIE_NAME=password_reset_token
CSRF_COOKIE_NAME=csrf_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_SECRET=replace-with-another-random-secret-at-least-64-characters-long

# NestJS-to-FastAPI request signing
HMAC_SECRET=replace-with-a-shared-random-secret-at-least-64-characters-long
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# Gmail verification and password-reset email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=replace-with-your-16-character-google-app-password
MAIL_FROM="AI Document Intelligence <your-gmail-address@gmail.com>"

# API documentation
SWAGGER_TITLE=AI Document Intelligence API
SWAGGER_VERSION=1.0
