<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Organization invitation</title>
  </head>
  <body style="margin: 0; background: #f4f6f8; font-family: Arial, sans-serif; color: #17202a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background: #f4f6f8; padding: 32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 560px; background: #ffffff; border-radius: 12px; padding: 32px;">
            <tr>
              <td>
                <p style="margin: 0 0 8px; color: #5b4cf0; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;">
                  AI Document Intelligence
                </p>
                <h1 style="margin: 0 0 16px; font-size: 24px;">
                  You're invited to {{organizationName}}
                </h1>
                <p style="margin: 0 0 24px; line-height: 1.6;">
                  An administrator invited you to join this organization. Sign in with <strong>{{invitedEmail}}</strong>, then accept the invitation.
                </p>
                <p style="margin: 0 0 24px;">
                  <a href="{{inviteUrl}}" style="display: inline-block; padding: 12px 20px; border-radius: 8px; background: #5b4cf0; color: #ffffff; text-decoration: none; font-weight: 700;">
                    Accept invitation
                  </a>
                </p>
                <p style="margin: 0 0 8px; line-height: 1.6;">
                  This invitation expires in {{expiresInDays}} days. If the button does not work, copy and paste this URL into your browser:
                </p>
                <p style="margin: 0; overflow-wrap: anywhere; line-height: 1.6;">
                  <a href="{{inviteUrl}}">{{inviteUrl}}</a>
                </p>
                <p style="margin: 24px 0 0; color: #5f6b7a; line-height: 1.6;">
                  If you did not expect this invitation, you can safely ignore this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
