<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify your email address</title>
  </head>
  <body style="margin: 0; background: #f4f6f8; font-family: Arial, sans-serif; color: #17202a;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background: #f4f6f8; padding: 32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 560px; background: #ffffff; border-radius: 12px; padding: 32px;">
            <tr>
              <td>
                <h1 style="margin: 0 0 16px; font-size: 24px;">Verify your email address</h1>
                <p style="margin: 0 0 24px; line-height: 1.6;">
                  Welcome to AI Document Intelligence. Confirm your email address to finish creating your account.
                </p>
                <p style="margin: 0 0 24px;">
                  <a href="{{verificationUrl}}" style="display: inline-block; padding: 12px 20px; border-radius: 8px; background: #2563eb; color: #ffffff; text-decoration: none; font-weight: 600;">
                    Verify email
                  </a>
                </p>
                <p style="margin: 0 0 8px; line-height: 1.6;">
                  This link expires in 24 hours. If the button does not work, copy and paste this URL into your browser:
                </p>
                <p style="margin: 0; overflow-wrap: anywhere; line-height: 1.6;">
                  <a href="{{verificationUrl}}">{{verificationUrl}}</a>
                </p>
                <p style="margin: 24px 0 0; color: #5f6b7a; line-height: 1.6;">
                  If you did not create an account, you can safely ignore this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
