generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AccessScope {
  PLATFORM
  ORGANIZATION
}

enum RoleAssignmentSource {
  BOOTSTRAP
  ADMIN
  SYSTEM
}

enum OrganizationInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum DocumentStatus {
  ACTIVE
  SOFT_DELETED_BY_USER
  SOFT_DELETED_BY_ORG
  PURGED
}

enum DocumentAccessLevel {
  PREVIEW
}

enum DocumentUploadSessionStatus {
  PENDING
  COMMITTED
  CANCELED
  EXPIRED
}

enum DocumentStagedFileStatus {
  READY
  REJECTED
  REMOVED
  COMMITTED
}

enum DocumentRagIndexStatus {
  PENDING
  INDEXING
  INDEXED
  FAILED
  NO_CONTENT
}

model User {
  id                            String                   @id @default(uuid()) @db.Uuid
  name                          String?                  @db.VarChar(150)
  email                         String                   @unique
  passwordHash                  String                   @map("password_hash")
  isVerified                    Boolean                  @default(false) @map("is_verified")
  isActive                      Boolean                  @default(true) @map("is_active")
  deactivatedAt                 DateTime?                @map("deactivated_at")
  createdAt                     DateTime                 @default(now()) @map("created_at")
  updatedAt                     DateTime                 @updatedAt @map("updated_at")
  sessions                      Session[]
  emailVerificationTokens       EmailVerificationToken[]
  passwordResetAuthorizations   PasswordResetAuthorization[]
  organizationMemberships       OrganizationMembership[]
  createdOrganizations          Organization[]           @relation("OrganizationCreator")
  organizationInvitesSent       OrganizationInvite[]     @relation("OrganizationInviteInviter")
  organizationInvitesAccepted   OrganizationInvite[]     @relation("OrganizationInviteAccepter")
  joinRequests                  JoinRequest[]            @relation("JoinRequestRequester")
  joinRequestsReviewed          JoinRequest[]            @relation("JoinRequestReviewer")
  auditLogs                     AuditLog[]               @relation("AuditLogActor")
  documentsCreated              Document[]               @relation("DocumentCreator")
  documentVersionsCreated       DocumentVersion[]        @relation("DocumentVersionCreator")
  documentUserDeletions         Document[]               @relation("DocumentUserDeleter")
  documentOrgDeletions          Document[]               @relation("DocumentOrgDeleter")
  documentRestorations          Document[]               @relation("DocumentRestorer")
  documentPurges                Document[]               @relation("DocumentPurger")
  documentAccessGrants          DocumentAccess[]         @relation("DocumentAccessUser")
  documentAccessGranted         DocumentAccess[]         @relation("DocumentAccessGranter")
  documentUploadSessions        DocumentUploadSession[]  @relation("DocumentUploadSessionCreator")
  platformRoleAssignments       PlatformUserRole[]       @relation("PlatformRoleAssignee")
  platformRoleAssignmentsMade   PlatformUserRole[]       @relation("PlatformRoleAssigner")
  membershipRoleAssignmentsMade MembershipRole[]         @relation("MembershipRoleAssigner")
  rolePermissionGrantsMade      RolePermission[]         @relation("RolePermissionGranter")

  @@map("users")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, revokedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetAuthorization {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, revokedAt])
  @@index([expiresAt])
  @@map("password_reset_authorizations")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  deviceName   String?   @map("device_name") @db.VarChar(255)
  userAgent    String?   @map("user_agent") @db.Text
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason") @db.VarChar(50)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Organization {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String                   @db.VarChar(150)
  slug            String                   @unique @db.VarChar(100)
  createdByUserId String?                  @map("created_by_user_id") @db.Uuid
  status          OrganizationStatus       @default(ACTIVE)
  allowJoinRequests Boolean                 @default(true) @map("allow_join_requests")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  createdBy       User?                    @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships     OrganizationMembership[]
  roles           Role[]
  invites         OrganizationInvite[]
  joinRequests    JoinRequest[]
  auditLogs       AuditLog[]
  documents       Document[]
  documentRagIndexes DocumentRagIndex[]
  documentUploadSessions DocumentUploadSession[]
  subscription    OrganizationSubscription?
  limits          OrganizationLimit?

  @@index([createdByUserId])
  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  userId         String                       @map("user_id") @db.Uuid
  status         OrganizationMembershipStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model Role {
  id                      String             @id @default(uuid()) @db.Uuid
  organizationId          String?            @map("organization_id") @db.Uuid
  systemKey               String?            @unique @map("system_key") @db.VarChar(100)
  name                    String             @db.VarChar(100)
  normalizedName          String             @map("normalized_name") @db.VarChar(100)
  description             String?            @db.VarChar(500)
  scope                   AccessScope
  isSystem                Boolean            @default(false) @map("is_system")
  isActive                Boolean            @default(true) @map("is_active")
  autoGrantNewPermissions Boolean            @default(false) @map("auto_grant_new_permissions")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  organization            Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions             RolePermission[]
  membershipAssignments   MembershipRole[]
  inviteAssignments       OrganizationInviteRole[]
  platformAssignments     PlatformUserRole[]

  @@unique([organizationId, normalizedName])
  @@index([scope, isActive])
  @@index([organizationId, isActive])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  category    String           @db.VarChar(80)
  scope       AccessScope
  isSystem    Boolean          @default(false) @map("is_system")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@index([scope, isActive])
  @@index([category, isActive])
  @@map("permissions")
}

model RolePermission {
  roleId          String     @map("role_id") @db.Uuid
  permissionId    String     @map("permission_id") @db.Uuid
  grantedByUserId String?    @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime   @default(now()) @map("granted_at")
  role            Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy       User?      @relation("RolePermissionGranter", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([grantedByUserId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId     String                 @map("membership_id") @db.Uuid
  roleId           String                 @map("role_id") @db.Uuid
  assignedByUserId String?                @map("assigned_by_user_id") @db.Uuid
  source           RoleAssignmentSource   @default(ADMIN)
  assignedAt       DateTime               @default(now()) @map("assigned_at")
  membership       OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role             Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy       User?                  @relation("MembershipRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("membership_roles")
}

model PlatformUserRole {
  userId           String               @map("user_id") @db.Uuid
  roleId           String               @map("role_id") @db.Uuid
  assignedByUserId String?              @map("assigned_by_user_id") @db.Uuid
  source           RoleAssignmentSource @default(ADMIN)
  assignedAt       DateTime             @default(now()) @map("assigned_at")
  user             User                 @relation("PlatformRoleAssignee", fields: [userId], references: [id], onDelete: Cascade)
  role             Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy       User?                @relation("PlatformRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("platform_user_roles")
}

model OrganizationInvite {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  invitedName      String?                  @map("invited_name") @db.VarChar(150)
  email            String                   @db.VarChar(254)
  tokenHash        String                   @unique @map("token_hash") @db.VarChar(64)
  status           OrganizationInviteStatus @default(PENDING)
  invitedByUserId  String?                  @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?                  @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime                 @map("expires_at")
  acceptedAt       DateTime?                @map("accepted_at")
  revokedAt        DateTime?                @map("revoked_at")
  lastSentAt       DateTime?                @map("last_sent_at")
  lastSendFailureAt DateTime?               @map("last_send_failure_at")
  lastSendFailureReason String?             @map("last_send_failure_reason") @db.VarChar(500)
  temporaryPasswordHash String?             @map("temporary_password_hash") @db.VarChar(255)
  temporaryPasswordExpiresAt DateTime?      @map("temporary_password_expires_at")
  temporaryPasswordUsedAt DateTime?         @map("temporary_password_used_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User?                    @relation("OrganizationInviteInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedBy       User?                    @relation("OrganizationInviteAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  roles            OrganizationInviteRole[]

  @@index([organizationId, status, expiresAt])
  @@index([email, status])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
  @@map("organization_invites")
}

model OrganizationInviteRole {
  inviteId   String             @map("invite_id") @db.Uuid
  roleId     String             @map("role_id") @db.Uuid
  assignedAt DateTime           @default(now()) @map("assigned_at")
  invite     OrganizationInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([inviteId, roleId])
  @@index([roleId])
  @@map("organization_invite_roles")
}

model OrganizationSubscription {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @unique @map("organization_id") @db.Uuid
  plan                String             @default("FREE") @db.VarChar(40)
  status              SubscriptionStatus @default(ACTIVE)
  currentPeriodEndsAt DateTime?          @map("current_period_ends_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([plan, status])
  @@map("organization_subscriptions")
}

model OrganizationLimit {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @unique @map("organization_id") @db.Uuid
  maxMembers           Int          @default(10) @map("max_members")
  maxDocuments         Int          @default(1000) @map("max_documents")
  maxStorageMb         Int          @default(1024) @map("max_storage_mb")
  maxMonthlyAiRequests Int          @default(1000) @map("max_monthly_ai_requests")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_limits")
}

model JoinRequest {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  message         String?           @db.VarChar(1000)
  status          JoinRequestStatus @default(PENDING)
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  rejectionReason String?           @map("rejection_reason") @db.VarChar(1000)
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  user            User              @relation("JoinRequestRequester", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy      User?             @relation("JoinRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("join_requests")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  actorName      String?      @map("actor_name") @db.VarChar(150)
  actorEmail     String?      @map("actor_email") @db.VarChar(254)
  organizationId String?      @map("organization_id") @db.Uuid
  action         String       @db.VarChar(160)
  method         String       @db.VarChar(12)
  path           String       @db.VarChar(500)
  resource       String       @db.VarChar(120)
  statusCode     Int?         @map("status_code")
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  userAgent      String?      @map("user_agent") @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  actor          User?        @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  name            String         @db.VarChar(255)
  originalFilename String        @map("original_filename") @db.VarChar(255)
  extension       String         @db.VarChar(16)
  mimeType        String         @map("mime_type") @db.VarChar(120)
  sizeBytes       Int            @map("size_bytes")
  checksumSha256  String         @map("checksum_sha256") @db.VarChar(64)
  storageBucket   String         @map("storage_bucket") @db.VarChar(80)
  storageKey      String         @map("storage_key") @db.VarChar(500)
  status          DocumentStatus @default(ACTIVE)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  userDeletedByUserId String?    @map("user_deleted_by_user_id") @db.Uuid
  userDeletedAt   DateTime?      @map("user_deleted_at")
  orgDeletedByUserId String?     @map("org_deleted_by_user_id") @db.Uuid
  orgDeletedAt    DateTime?      @map("org_deleted_at")
  restoredByUserId String?       @map("restored_by_user_id") @db.Uuid
  restoredAt      DateTime?      @map("restored_at")
  purgedByUserId  String?        @map("purged_by_user_id") @db.Uuid
  purgedAt        DateTime?      @map("purged_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User           @relation("DocumentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  userDeletedBy   User?          @relation("DocumentUserDeleter", fields: [userDeletedByUserId], references: [id], onDelete: SetNull)
  orgDeletedBy    User?          @relation("DocumentOrgDeleter", fields: [orgDeletedByUserId], references: [id], onDelete: SetNull)
  restoredBy      User?          @relation("DocumentRestorer", fields: [restoredByUserId], references: [id], onDelete: SetNull)
  purgedBy        User?          @relation("DocumentPurger", fields: [purgedByUserId], references: [id], onDelete: SetNull)
  versions        DocumentVersion[]
  accessGrants    DocumentAccess[]
  ragIndex        DocumentRagIndex?

  @@index([organizationId, status, updatedAt])
  @@index([createdByUserId, status, updatedAt])
  @@index([checksumSha256])
  @@map("documents")
}

model DocumentRagIndex {
  id              String                 @id @default(uuid()) @db.Uuid
  documentId      String                 @unique @map("document_id") @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  versionId       String?                @map("version_id") @db.Uuid
  versionNumber   Int                    @map("version_number")
  status          DocumentRagIndexStatus @default(PENDING)
  chunksCount     Int                    @default(0) @map("chunks_count")
  embeddingModel  String                 @map("embedding_model") @db.VarChar(120)
  errorMessage    String?                @map("error_message") @db.Text
  indexedAt       DateTime?              @map("indexed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  document        Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([documentId, versionNumber])
  @@map("document_rag_indexes")
}

model DocumentVersion {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  versionNumber   Int      @map("version_number")
  name            String   @db.VarChar(255)
  originalFilename String  @map("original_filename") @db.VarChar(255)
  extension       String   @db.VarChar(16)
  mimeType        String   @map("mime_type") @db.VarChar(120)
  sizeBytes       Int      @map("size_bytes")
  checksumSha256  String   @map("checksum_sha256") @db.VarChar(64)
  storageBucket   String   @map("storage_bucket") @db.VarChar(80)
  storageKey      String   @map("storage_key") @db.VarChar(500)
  metadata        Json?
  preview         Json?
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("DocumentVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@index([organizationId, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("document_versions")
}

model DocumentAccess {
  id              String              @id @default(uuid()) @db.Uuid
  documentId      String              @map("document_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  accessLevel     DocumentAccessLevel @default(PREVIEW) @map("access_level")
  grantedByUserId String              @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime?           @map("revoked_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  document        Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user            User                @relation("DocumentAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User                @relation("DocumentAccessGranter", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@index([documentId, revokedAt])
  @@index([userId, revokedAt])
  @@map("document_access")
}

model DocumentUploadSession {
  id              String                      @id @default(uuid()) @db.Uuid
  organizationId  String                      @map("organization_id") @db.Uuid
  createdByUserId String                      @map("created_by_user_id") @db.Uuid
  status          DocumentUploadSessionStatus @default(PENDING)
  expiresAt       DateTime                    @map("expires_at")
  committedAt     DateTime?                   @map("committed_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                        @relation("DocumentUploadSessionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  files           DocumentUploadStagedFile[]

  @@index([organizationId, status, createdAt])
  @@index([createdByUserId, status, createdAt])
  @@map("document_upload_sessions")
}

model DocumentUploadStagedFile {
  id              String                   @id @default(uuid()) @db.Uuid
  uploadSessionId String                   @map("upload_session_id") @db.Uuid
  position        Int
  originalFilename String                  @map("original_filename") @db.VarChar(255)
  extension       String                   @db.VarChar(16)
  mimeType        String                   @map("mime_type") @db.VarChar(120)
  sizeBytes       Int                      @map("size_bytes")
  checksumSha256  String                   @map("checksum_sha256") @db.VarChar(64)
  storageBucket   String                   @map("storage_bucket") @db.VarChar(80)
  storageKey      String                   @map("storage_key") @db.VarChar(500)
  metadata        Json?
  preview         Json?
  status          DocumentStagedFileStatus @default(READY)
  rejectionReason String?                  @map("rejection_reason") @db.VarChar(500)
  sourceArchiveName String?                @map("source_archive_name") @db.VarChar(255)
  sourceArchivePath String?                @map("source_archive_path") @db.VarChar(500)
  createdAt       DateTime                 @default(now()) @map("created_at")

  uploadSession   DocumentUploadSession    @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@index([uploadSessionId, status])
  @@map("document_upload_staged_files")
}
