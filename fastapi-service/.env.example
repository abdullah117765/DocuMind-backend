# Application
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# PostgreSQL
# Use a read-only database user when FastAPI database access is implemented.
DATABASE_URL=postgresql://fastapi_reader:replace-with-password@localhost:5432/ai_doc_intel

# NestJS-to-FastAPI request verification
# This must contain exactly the same value as NestJS RAG_HMAC_SECRET.
# Format: HMAC_SECRET=<secret>, not HMAC_SECRET=HMAC_SECRET=<secret>.
HMAC_SECRET=replace-with-a-shared-random-secret-at-least-64-characters-long
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# MinIO document storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_DOCUMENT_BUCKET=documents

# Qdrant vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embeddings and chunking
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_QUERY_PREFIX=Represent this sentence:
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# RAG retrieval tuning
# FastAPI retrieves a candidate pool, filters it, reranks it, then sends only
# the final selected context to the LLM.
RAG_INITIAL_CANDIDATE_K=30
RAG_MAX_CANDIDATE_K=50
RAG_MIN_RELEVANCE_SCORE=0.2
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANKER_WEIGHT=0.75
RAG_MIN_RERANKED_SCORE=0.2
RAG_MAX_FINAL_CHUNKS=10
RAG_MAX_CONTEXT_TOKENS=3000
RAG_CONTEXT_METADATA_TOKENS=80
RAG_REDUNDANCY_THRESHOLD=0.88

# LLM provider
# Put your Gemini key here when you are ready to enable Ask AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
